# ===== 数据库 =====
# 本地 SQLite 数据库文件路径
DATABASE_PATH=data/campus_trade.db
# 可选：数据库连接串，设置后优先于 DATABASE_PATH
# DATABASE_URL=sqlite:///data/campus_trade.db

# ===== 输入 =====
# 用户场景描述文件，支持 .md / .txt
SCENARIO_INPUT_PATH=input/scenario.md

# ===== 生成产物路径 =====
SCHEMA_OUTPUT_PATH=output/schema_descriptions.json
BUSINESS_SCENARIOS_PATH=output/business_scenarios.json
TEST_CASES_PATH=output/test_cases.json
TEST_DATA_PATH=output/test_data.json
SCENARIO_RULES_PATH=output/scenario_rules.json
GENERATED_TEST_SUITE_PATH=output/generated_test_suite.json

# ===== 测试执行 =====
# 生成的 pytest 文件目录
AUTOMATED_TESTS_DIR=automated_tests
# pytest 结构化结果与 JUnit 原始结果
PYTEST_RESULT_PATH=output/pytest_result.json
PYTEST_JUNIT_PATH=output/pytest_junit.xml

# ===== 审查与评分 =====
COVERAGE_REPORT_PATH=output/coverage_report.json
REVIEW_REPORT_PATH=output/review_report.md

# ===== 缓存与运行指标 =====
# 增量生成缓存，记录场景与数据库结构 hash
PIPELINE_CACHE_PATH=output/pipeline_cache.json
# 各阶段耗时与 token 消耗
RUN_METRICS_PATH=output/run_metrics.json

# ===== 大模型配置 =====
# 必填：模型服务 API Key
OPENAI_API_KEY=your_openai_api_key
# 模型名称
OPENAI_MODEL_NAME=deepseek-v4-flash
# 可选：OpenAI 兼容接口地址
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== CrewAI =====
# 关闭遥测上传，避免网络超时拖慢运行
CREWAI_DISABLE_TELEMETRY=true
